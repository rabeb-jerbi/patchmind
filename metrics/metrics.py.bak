import time
from datetime import datetime


class PatchMindMetrics:
    """Collecte les métriques en mémoire uniquement. La sauvegarde SQL se fait dans app.py."""

    def __init__(self):
        self.session = {
            "timestamp": datetime.now().isoformat(),
            "total_vulns": 0,
            "patches_validated": 0,
            "patches_rejected": 0,
            "success_rate": 0.0,
            "mttr_seconds": 0.0,
            "total_duration": 0.0,
            "manual_review_required": 0,
            "total_detected": 0,
            "vulns": []
        }
        self.start_time = time.time()
        self._current_vuln = None

    def start_vuln(self, vuln):
        self._current_vuln = {
            "cwe": str(vuln.get("cwe", "CWE-UNKNOWN")).split(":")[0].strip(),
            "file": vuln.get("file", ""),
            "line": vuln.get("line", 0),
            "severity": vuln.get("severity", "MEDIUM"),
            "start_time": time.time(),
            "stages": {}
        }

    def record_stage(self, stage_name, duration):
        if self._current_vuln:
            self._current_vuln["stages"][stage_name] = round(duration, 2)

    def end_vuln(self, success):
        if not self._current_vuln:
            return
        duration = time.time() - self._current_vuln["start_time"]
        self._current_vuln["total_seconds"] = round(duration, 2)
        self._current_vuln["success"] = bool(success)
        self.session["vulns"].append(self._current_vuln)
        self.session["total_vulns"] += 1
        if success:
            self.session["patches_validated"] += 1
        else:
            self.session["patches_rejected"] += 1
        self._current_vuln = None

    def finalize(self, total_detected=None, manual_review_required=0):
        patchable_total = self.session["total_vulns"]
        if patchable_total > 0:
            self.session["success_rate"] = round(
                self.session["patches_validated"] / patchable_total * 100, 1
            )
            durations = [v["total_seconds"] for v in self.session["vulns"] if v.get("success")]
            if durations:
                self.session["mttr_seconds"] = round(sum(durations) / len(durations), 2)

        self.session["total_duration"] = round(time.time() - self.start_time, 2)
        self.session["total_detected"] = int(total_detected or patchable_total)
        self.session["manual_review_required"] = int(manual_review_required or 0)
        self._display()

    def _display(self):
        print("\n" + "=" * 60)
        print("📊 MÉTRIQUES PATCHMIND")
        print("=" * 60)
        print(f"  📅 Session              : {self.session['timestamp'][:19]}")
        print(f"  🔎 Total détecté         : {self.session['total_detected']}")
        print(f"  🔢 Vulns patchables      : {self.session['total_vulns']}")
        print(f"  📝 Revue manuelle        : {self.session['manual_review_required']}")
        print(f"  ✅ Validés              : {self.session['patches_validated']}")
        print(f"  ❌ Rejetés              : {self.session['patches_rejected']}")
        print(f"  📈 Success rate         : {self.session['success_rate']}%")
        print(f"  ⏱️  Durée totale         : {self.session['total_duration']} sec")
